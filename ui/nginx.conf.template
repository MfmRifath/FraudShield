# Static analyst UI + reverse proxy to the API (the browser only ever talks to this origin).
# Rendered by the nginx image's entrypoint (envsubst): ${FRAUDSHIELD_API_UPSTREAM}, and
# ${NGINX_LOCAL_RESOLVERS} from /etc/resolv.conf. The upstream is a variable so nginx re-resolves
# it: a recreated API container gets a new IP, which a startup-time lookup would keep pointing at.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api http://${FRAUDSHIELD_API_UPSTREAM};

    location = /healthz { access_log off; return 200 "ok\n"; }

    # the UI never calls admin endpoints or /metrics; keep them off the browser-facing origin
    location /api/admin/ { return 403; }
    location = /api/metrics { return 403; }

    # Server-sent events: no buffering, long reads, HTTP/1.1 keep-alive to the upstream.
    location = /api/events/stream {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location / { try_files $uri /index.html; add_header Cache-Control "no-cache"; }
}
