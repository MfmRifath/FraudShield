# Linux test runner: same uv + Python as CI, plus the OpenMP runtime LightGBM needs.
# Used by `make test-docker` (useful on macOS without `brew install libomp`).
FROM ghcr.io/astral-sh/uv:0.12.24-python3.12-trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 make git \
    && rm -rf /var/lib/apt/lists/*
ENV UV_PROJECT_ENVIRONMENT=/venv UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
