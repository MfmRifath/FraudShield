# Copy to /opt/fraudshield/.env on the VM (never commit the filled-in file).
FS_DOMAIN=fraud.example.com
FS_UI_USER=analyst
# docker run --rm caddy:2.11.6-alpine caddy hash-password --plaintext '<password>'
# ($ must be doubled in .env files read by compose: $$2a$$14$$...)
FS_UI_PASSWORD_HASH=
FS_ADMIN_TOKEN=          # long random string: openssl rand -hex 32
FS_PG_PASSWORD=          # Postgres password (compose default is for laptops only)
FS_IMAGE_PREFIX=ghcr.io/mfmrifath/
FS_TAG=latest
FS_CASE_STORE=postgres
FS_MODEL_SOURCE=mlflow   # serve models:/fraudshield@champion from the registry
